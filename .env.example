# Copie para .env e preencha. Nunca commite o .env.
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Chave da API da Anthropic (análise de cenas com Claude). Opcional se você
# já estiver autenticado com `ant auth login`; sem credencial, usa a heurística.
ANTHROPIC_API_KEY=
# Chave da API da OpenAI (ChatGPT), para usar --ai openai no lugar do Claude.
OPENAI_API_KEY=
# Wikimedia Commons (fotos de modelos exatos): não tem chave, só pede um contato
# para identificar quem consulta (seu e-mail ou o link do canal).
WIKIMEDIA_CONTACT=
# Openverse (fotos Creative Commons de Flickr, museus e acervos): funciona sem chave.
# Com chave o limite é bem maior; cadastro grátis: python -m broll_bot.providers.openverse --email voce@...
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# YouTube Data API v3 (vídeos Creative Commons do YouTube): chave grátis no Google Cloud Console.
YOUTUBE_API_KEY=
# Navegador logado no YouTube (o yt-dlp usa o login dele quando o YouTube barra como robô): firefox
YOUTUBE_COOKIES_FROM_BROWSER=
# Serper (Google Imagens): fotos dos produtos, lojas e pessoas que o roteiro cita (named_images no config.yaml).
# Cadastro em serper.dev: 2.500 buscas grátis; cada vídeo usa umas 15.
SERPER_API_KEY=
